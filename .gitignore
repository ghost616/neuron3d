# ======================================================================
# H-STDN 项目 .gitignore（Python 3.12）
# ======================================================================

# ---- Python 字节码与包构建产物 ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# ---- 虚拟环境 ----
.venv/
venv/
env/
.venv-win/

# ---- 测试 / 静态检查 / 类型检查缓存 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ---- Node / 前端依赖（Playwright 测试依赖，不入库）----
# n3d_viz/tests/ 下由 npm 安装的 Playwright 测试依赖（183 文件、约 17.7 MB）属可
# 再生产物，不入版本控制；本规则防止 git add -A / git add . 误提交依赖目录。
node_modules/

# ---- IDE / 编辑器 / OS ----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- H-STDN 运行产物：实验结果 / 日志 / 检查点 / 诊断输出 ----
/outputs/
/runs/
/checkpoints/
/logs/
/exp/runs/
/exp/outputs/
*.log

# ---- Lizhu test env (local generated, not committed) ----
.lizhu_env/

# ---- 数据集原始文件（运行时复制，不入库）----
# data/mnist/ 下的原始 IDX 文件由版本控制跟踪；首次运行时 data.py 会把它们
# 复制到 torchvision 期望的布局 data/mnist/MNIST/raw/（4 个文件、约 11 MB）。
# 该目录是运行时副作用产物，只忽略它本身，不影响 data/mnist/ 下已跟踪的文件。
data/mnist/MNIST/
