{
  "requirements": "requirements_design.md",
  "modules": [
    {
      "name": "framework",
      "description": "系统框架模块，管理所有模块共用的文件（项目根配置、公共工具、G0 断言工具）",
      "responsibilities": [
        "管理项目根级配置文件与公共工具",
        "声明 Python 依赖并保证 Py3.12 兼容",
        "维护三件套纪律（patch+changelog+G0 断言）"
      ],
      "functions": [
        {
          "description": "requirements.txt / pyproject.toml / README / .gitignore",
          "name": "依赖与构建配置"
        },
        {
          "description": "ID 规范断言、契约断言辅助函数",
          "name": "G0 断言公共工具"
        }
      ]
    },
    {
      "name": "core",
      "description": "H-STDN 核心模拟模块（M1-M6），hstdn/core/ 下全部算法实现",
      "responsibilities": [
        "网络构建（平板布线、CSC、增益标定）",
        "模拟内核（时间轮 LIF + STDP）",
        "可塑性引擎与特征读出"
      ],
      "functions": [
        {
          "description": "network.py + spatial_hash.py + layout.py",
          "name": "M1 网络构建"
        },
        {
          "description": "encoder.py latency/DVS/MNIST 映射",
          "name": "M2 输入编码"
        },
        {
          "description": "kernel.py L0 时间轮内核",
          "name": "M3 模拟内核"
        },
        {
          "description": "plasticity.py input_channel_stdp+post_ltp+pre_ltd+homeo+norm",
          "name": "M4 可塑性"
        },
        {
          "description": "features.py V0/V1 + readout.py L0/L1/L2",
          "name": "M5 特征与读出"
        },
        {
          "description": "scheduler.py 状态机 + CALIBRATE",
          "name": "M6 训练调度"
        }
      ]
    },
    {
      "name": "data",
      "description": "H-STDN 数据模块：合成数据、MNIST、DVS-Gesture、GPU 桥接",
      "responsibilities": [
        "生成/加载训练数据",
        "输入映射（D14 裁决）",
        "CPU-GPU 批量桥接"
      ],
      "functions": [
        {
          "description": "synthetic.py 合成 10 类（G1）",
          "name": "合成数据"
        },
        {
          "description": "mnist.py 1k 子集 + 10x10 池化",
          "name": "MNIST"
        },
        {
          "description": "dvs_gesture.py patch 聚合 512 单元（预留）",
          "name": "DVS"
        },
        {
          "description": "gpu_bridge.py 批量缓冲（预留）",
          "name": "GPU 桥接"
        }
      ]
    },
    {
      "name": "exp",
      "description": "H-STDN 实验与验证模块：门禁、诊断、消融、配置",
      "responsibilities": [
        "G0-G4 门禁验证",
        "诊断面板",
        "消融与对照实验"
      ],
      "functions": [
        {
          "description": "gates.py 十五项断言",
          "name": "G0 门禁"
        },
        {
          "description": "diagnostics.py 率/沉默/cos/顶界突触等",
          "name": "诊断面板"
        },
        {
          "description": "ablation.py（G1 后）",
          "name": "消融对照"
        },
        {
          "description": "configs/default.yaml",
          "name": "超参配置"
        }
      ]
    },
    {
      "name": "main",
      "description": "H-STDN 训练与评估入口模块",
      "responsibilities": [
        "训练流程编排",
        "评估流程编排",
        "配置加载与可复现"
      ],
      "functions": [
        {
          "description": "train.py config→build→M6→checkpoint",
          "name": "训练入口"
        },
        {
          "description": "eval.py 测试+诊断",
          "name": "评估入口"
        }
      ]
    }
  ]
}