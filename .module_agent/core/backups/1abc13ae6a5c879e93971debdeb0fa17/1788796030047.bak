"""layout.py -- core module (M1-M6): ID contract, shape/dtype specs, hyper-parameters.

Design-document contracts (v3.2-final Sec.2.2/2.3, ID contract):
- **Storage layer** (CSR/CSC edges and the neuron index of the global trace
  array) always uses **global IDs**: ``0..N_IN-1`` are the input neurons,
  ``N_IN..N_IN+N_POOL-1`` are the pool neurons;
- **State-array access layer** (V/theta/refr/counts/rate_ema/ring/csc_ptr /
  in_learn_ptr) always uses **pool-local IDs** (``0..N_POOL-1``); the
  global->local conversion happens only at the kernel delivery site
  (``dst_local = dst - N_IN``).  This module exposes the single conversion
  helper ``pool_local_of``.

Responsibilities:
1. Central definition of the shape/dtype constants and of the Sec.4
   hyper-parameters (the only core-internal source; once
   ``hstdn/configs/default.yaml`` exists it becomes the single source and the
   values here degrade to fallbacks);
2. Global/local ID domain checks and conversions used by G0 #4/#10/#13 and by
   network/kernel/plasticity;
3. Structural shape/dtype invariant assertions on top of the shared
   ``hstdn.checks`` helpers.

Every failed check raises an ``AssertionError`` carrying a readable message
and the relevant statistics (G0 gate convention).
"""

from __future__ import annotations

from dataclasses import dataclass, field, replace
from typing import Any, Mapping, Optional

import numpy as np

from hstdn.checks import assert_dtype, assert_shape  # shared G0 helpers (framework)

__all__ = [
    # config & constants
    "NetConfig", "cfg_from_mapping", "DEFAULT_CFG",
    "N_IN", "N_POOL", "N_TOTAL", "N_INPUT_COLS", "REFR", "ETA_LTP", "ETA_LTD",
    "W_LO", "W_HI", "THETA0", "WHEEL_L", "DECAY_V", "DECAY_T",
    "R_IN", "R_POOL", "K_IN", "K_POOL",
    # dtypes
    "F8", "I8",
    # shape/dtype assertions
    "assert_pool_local_shape1", "assert_global_trace_shape", "assert_ring_shape",
    "assert_f8", "assert_i8",
    # ID domain checks & conversions
    "is_input_gid", "is_pool_gid", "assert_input_gids", "assert_pool_gids",
    "assert_pool_local_ids", "pool_local_of", "pool_gid_of",
]

#: Array dtype spec (Sec.2.2/2.3): states & weights are float64, ids/pointers/
#: counters are int64.
F8 = np.float64
I8 = np.int64


@dataclass(frozen=True)
class NetConfig:
    """Network/simulation hyper-parameters (design doc Sec.4); frozen/read-only.

    Field names follow the design-document notation.  kernel/plasticity/
    encoder must read values through ``bundle.cfg`` or this object only; magic
    numbers are forbidden (freeze discipline before G1).  ``with_derived`` is
    the only legal construction path (fills the derived fields below).
    """

    # --- scale ---
    n_in: int = 1024          # input neuron count (default: 32x32 plane grid)
    n_pool: int = 8000        # pool neuron count (slab domain wiring)
    n_input_cols: int = 32    # input grid side length (default n_in == side**2)
    e_frac: float = 0.8       # excitatory (E) pool fraction (80/20 E/I, D11)
    pool_learn: bool = True   # D11 learnability switch (frozen-pool plasticity
                              # for exp-g / Diehl-Cook regression): True = the
                              # default -- pool-to-pool E-source synapses are
                              # learnable.  False = freeze intra-pool
                              # plasticity: E-source pool edges keep their
                              # wiring, delays and initial weights
                              # U(0.18,0.42)*theta0 but are excluded from
                              # STDP/LTP/LTD and from the per-pool competitive
                              # budget -- in_learn_idx/in_sum0 then contain
                              # input->pool synapses only (input edges always
                              # learn; I-source edges never learn).
                              # Every construction path defaults to True.

    # --- geometry (slab domain D13: inputs on z=0 plane; pools in
    #     [0,1]x[0,1]x[0,pool_z_hi]) ---
    input_jitter: float = 0.25  # jitter amplitude = input_jitter * cell (1/side)
    pool_z_hi: float = 0.3      # pool slab z upper bound (D13)
    r_in: float = 0.4           # input->pool query radius R_IN
    k_in: int = 16              # input->pool: k nearest inputs per pool
    r_pool: float = 0.15        # pool->pool query radius R_POOL (also hash cell)
    k_pool: int = 12            # pool->pool per-source k nearest = 12 (D11)
    vel: float = 0.02           # conduction velocity VEL (space units / ms)
    delay_min: int = 1
    delay_max: int = 15         # wheel L = delay_max + 1 = 16; assert max<L

    # --- neurons & weights (gain-calibration basis theta0) ---
    theta0: float = 1.0         # threshold basis: input gain ~U(0.9,1.3)*theta0,
                                # E-loop strength ~0.3*theta0
    w_in_lo: float = 0.9        # input->pool weight low (=0.9*theta0)
    w_in_hi: float = 1.3        # input->pool weight high (=1.3*theta0)
    w_ee_lo: float = 0.18       # E-source weight low (about 0.18*theta0)
    w_ee_hi: float = 0.42       # E-source weight high (about 0.42*theta0)
    w_i_amp: float = 1.2        # I-source inhibitory amplitude
                                # w = -1.2*exp(-d/0.12); |w| >= E, non-learnable
    w_i_tau: float = 0.12       # spatial decay constant of I weights

    # --- temporal constants (ms) ---
    tau_m: float = 20.0         # membrane tau -> decayV = exp(-1/tau_m)
    tau_trace: float = 20.0     # trace tau -> decayT = exp(-1/tau_trace)
    refr: int = 2               # absolute refractory REFR: refr=t+REFR and only
                                # t>refr may fire again (R1 strict refractory)

    # --- STDP (D10/ADR-001/ADR-003) ---
    eta_ltp: float = 0.01       # post_ltp additive: csr_w += ETA_LTP*trace[src]
    eta_ltd: float = 0.01       # pre_ltd multiplicative: w *= (1-ETA_LTD*tr[dst])
    w_lo: float = 0.02          # global weight floor (clip [0.02, 1.5])
    w_hi: float = 1.5           # global weight ceiling (clip [0.02, 1.5])

    # --- per-neuron homeostasis ---
    homeo_ema_alpha: float = 0.1   # ema = 0.9*ema + 0.1*(counts/window_sec)
    homeo_rate_target: float = 8.0 # target firing rate (Hz)
    homeo_theta_lr: float = 0.05   # theta adaptation step
    theta_lo: float = 0.5
    theta_hi: float = 20.0
    window_s: float = 0.2          # stats window (matches default T=200 ms)

    # --- encoding (M2, D14) ---
    enc_t0: int = 2                # first spike time = 2 + (1-I)*40
    enc_t_span: float = 40.0
    enc_i_thr: float = 0.12        # only units with I > 0.12 fire
    poisson_on: bool = False       # Poisson encoding off by default

    # --- randomness ---
    seed: int = 0                  # build seed (E/I tags, jitter, weights)

    # --- derived frozen fields (filled by with_derived) ---
    decay_v: float = field(default=0.0, repr=False)
    decay_t: float = field(default=0.0, repr=False)
    wheel_l: int = field(default=0, repr=False)   # wheel L = delay_max + 1
    n_total: int = field(default=0, repr=False)   # N_IN + N_POOL
    n_e_pool: int = field(default=0, repr=False)  # number of E pools
    n_i_pool: int = field(default=0, repr=False)  # number of I pools

    def with_derived(self) -> "NetConfig":
        """Validate and fill derived fields; returns a new frozen instance."""
        import math

        if self.n_in <= 0 or self.n_pool <= 0:
            raise ValueError(
                "n_in/n_pool must be positive integers, got "
                f"{self.n_in}/{self.n_pool}"
            )
        if self.delay_min < 1:
            raise ValueError("delay_min must be >= 1 (no same-step chain firing)")
        if self.delay_max < self.delay_min:
            raise ValueError(
                f"delay_max({self.delay_max}) must be >= delay_min({self.delay_min})"
            )
        if not math.isfinite(self.theta0) or self.theta0 <= 0:
            raise ValueError(f"theta0 must be a positive finite value, got {self.theta0}")
        n_e = int(round(self.n_pool * self.e_frac))
        return replace(
            self,
            decay_v=float(np.exp(-1.0 / self.tau_m)),
            decay_t=float(np.exp(-1.0 / self.tau_trace)),
            wheel_l=int(self.delay_max + 1),
            n_total=int(self.n_in + self.n_pool),
            n_e_pool=n_e,
            n_i_pool=int(self.n_pool - n_e),
        )


def cfg_from_mapping(mapping: Optional[Mapping[str, Any]] = None) -> NetConfig:
    """Build a NetConfig from a dict/yaml-like mapping (partial overrides).

    Args:
        mapping: optional; any subset of NetConfig field names (yaml result).

    Returns:
        A valid NetConfig with derived fields filled by ``with_derived``.

    Raises:
        ValueError: on unknown keys (typo protection; freeze discipline).
    """
    if mapping is None:
        return DEFAULT_CFG
    known = set(NetConfig.__dataclass_fields__)
    extra = set(mapping) - known
    if extra:
        raise ValueError(f"unknown hyper-parameter keys: {sorted(extra)}")
    return replace(
        DEFAULT_CFG, **{k: v for k, v in mapping.items() if k in known}
    ).with_derived()


#: Default configuration (Sec.4 frozen values).  Once configs/default.yaml is
#: ready it becomes the unique source and these degrade to fallbacks.
DEFAULT_CFG: NetConfig = NetConfig().with_derived()

# --- module-level constants (design-doc notation; used by G0 #4/#10/#13) ---
N_IN: int = DEFAULT_CFG.n_in
N_POOL: int = DEFAULT_CFG.n_pool
N_TOTAL: int = DEFAULT_CFG.n_total
N_INPUT_COLS: int = DEFAULT_CFG.n_input_cols
REFR: int = DEFAULT_CFG.refr                # strict refractory (R1)
ETA_LTP: float = DEFAULT_CFG.eta_ltp
ETA_LTD: float = DEFAULT_CFG.eta_ltd
W_LO: float = DEFAULT_CFG.w_lo
W_HI: float = DEFAULT_CFG.w_hi
THETA0: float = DEFAULT_CFG.theta0
WHEEL_L: int = DEFAULT_CFG.wheel_l          # time wheel L = 16
DECAY_V: float = DEFAULT_CFG.decay_v
DECAY_T: float = DEFAULT_CFG.decay_t
R_IN: float = DEFAULT_CFG.r_in
R_POOL: float = DEFAULT_CFG.r_pool
K_IN: int = DEFAULT_CFG.k_in
K_POOL: int = DEFAULT_CFG.k_pool


# ---------------------------------------------------------------------------
# ID-domain checks & conversions (ID contract; violation == failure)
# ---------------------------------------------------------------------------


def is_input_gid(gid: int, n_in: int = N_IN) -> bool:
    """True iff the global id lies in the input domain 0..n_in-1."""
    return 0 <= int(gid) < int(n_in)


def is_pool_gid(gid: int, n_in: int = N_IN, n_pool: int = N_POOL) -> bool:
    """True iff the global id lies in the pool domain n_in..n_in+n_pool-1."""
    return int(n_in) <= int(gid) < int(n_in) + int(n_pool)


def assert_input_gids(ids: Any, n_in: int = N_IN, *, name: str = "ids") -> None:
    """Assert a 1-D integer array holds only **input** global ids (in [0, n_in)).

    Args:
        ids: 1-D integer array-like.
        n_in: input domain upper bound (defaults to module constant).
        name: object name used in the message.

    Returns:
        None; raises AssertionError on out-of-domain ids (counts + range).
    """
    from hstdn.checks import assert_global_ids

    arr = np.asarray(ids)
    assert_global_ids(arr, n_in, name=name)


def assert_pool_gids(ids: Any, n_in: int = N_IN, n_pool: int = N_POOL,
                     *, name: str = "ids") -> None:
    """Assert a 1-D integer array holds only **pool** global ids
    (in [n_in, n_in+n_pool)).

    Args:
        ids: 1-D integer array-like.
        n_in/n_pool: domain bounds (defaults to module constants).
        name: object name used in the message.

    Returns:
        None; raises AssertionError on non-pool ids (counts + range).
    """
    from hstdn.checks import assert_global_ids

    arr = np.asarray(ids)
    assert_global_ids(arr, n_in + n_pool, name=name)
    if arr.size:
        bad = int(np.count_nonzero(arr < n_in))
        if bad:
            raise AssertionError(
                f"{name}: {bad}/{arr.size} ids are not pool global ids "
                f"(expected in [{n_in}, {n_in + n_pool})): actual range "
                f"[{int(arr.min())}, {int(arr.max())}]"
            )


def assert_pool_local_ids(ids: Any, n_pool: int = N_POOL, *, name: str = "ids") -> None:
    """Assert a 1-D integer array holds only **pool-local** ids (in [0, n_pool)).

    Pool-local IDs are used by the state-array access layer only.

    Args:
        ids: 1-D integer array-like.
        n_pool: pool size (defaults to module constant).
        name: object name used in the message.

    Returns:
        None; raises AssertionError on out-of-domain ids.
    """
    from hstdn.checks import assert_local_ids

    assert_local_ids(np.asarray(ids), n_pool, name=name)


def pool_local_of(gid: int, n_in: int = N_IN, n_pool: int = N_POOL) -> int:
    """**The** global->local conversion entry (delivery site contract).

    Args:
        gid: pool neuron global id.

    Returns:
        The pool-local id (0..n_pool-1).

    Raises:
        AssertionError: if gid is not in the pool domain (guards against
            mistaking an input global id for a local one).
    """
    assert_pool_gids(np.asarray([gid], dtype=np.int64), n_in=n_in, n_pool=n_pool,
                     name="pool_local_of(gid)")
    return int(gid) - int(n_in)


def pool_gid_of(local: int, n_in: int = N_IN, n_pool: int = N_POOL) -> int:
    """Pool-local id -> global id (storage construction only, never state access)."""
    assert_pool_local_ids(np.asarray([local], dtype=np.int64), n_pool=n_pool,
                          name="pool_gid_of(local)")
    return int(local) + int(n_in)


# ---------------------------------------------------------------------------
# shape/dtype invariant assertions (reused by G0 #13 & structural self-check)
# ---------------------------------------------------------------------------


def assert_pool_local_shape1(arr: Any, *, name: str = "arr",
                             n_pool: int = N_POOL) -> None:
    """Assert 1-D (n_pool,) pool-local state array shape (shape/dtype, G0 #13)."""
    assert_shape(arr, (n_pool,), name=name)


def assert_global_trace_shape(arr: Any, *, name: str = "trace",
                              n_in: int = N_IN, n_pool: int = N_POOL) -> None:
    """Assert the global trace array shape (n_in+n_pool,) (global-ID contract)."""
    assert_shape(arr, (n_in + n_pool,), name=name)


def assert_ring_shape(arr: Any, *, name: str = "ring",
                      wheel_l: int = WHEEL_L, n_pool: int = N_POOL) -> None:
    """Assert the time-wheel ring shape (L, n_pool) (slot-major; local columns)."""
    assert_shape(arr, (wheel_l, n_pool), name=name)


def assert_f8(a: Any, *, name: str = "arr") -> None:
    """Assert float64 dtype (state/weight arrays, Sec.2.2)."""
    assert_dtype(a, F8, name=name)


def assert_i8(a: Any, *, name: str = "arr") -> None:
    """Assert int64 dtype (id/pointer/counter arrays, Sec.2.2)."""
    assert_dtype(a, I8, name=name)