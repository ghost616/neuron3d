"""n3d_shape 训练对照账本校验脚本（离朱信息项 I2 的补齐）。

职责
----
独立复算五组形状对照产物的实测指标（`test_acc` / `E` / `K` / `|S_in|` / `|S_out|` /
`params` / `SHA256`），并与账本 `full_runs_shape.json` 逐项比对，同时校验：

* 五组产物**名字互不相同**、**SHA256 互不相同**（防撞名硬要求）；
* 产物文件名 == `train.full_checkpoint_name(config)` 给出的规范名；
* checkpoint 内 `config["shape"]` / `config["cyl_aspect"]` / `shape_tag` 与实际形状一致；
* 账本中的 `test_acc` 与 checkpoint 内取证**逐组一致**（禁止无产物支撑的数字）。

用法
----
    python n3d_shape/verify_full_runs.py      # 退出码 0 = 全部一致；1 = 存在不一致

说明
----
本脚本只读产物、不写任何 checkpoint；报告打印到 stdout。
"""
from __future__ import annotations

import hashlib
import json
import math
import os
import sys
from typing import Any, Dict, List, Tuple

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import torch  # noqa: E402

try:
    from .config import Config  # noqa: E402
    from .model import ThreeDNeuronSpace  # noqa: E402
    from . import train as train_mod  # noqa: E402
except ImportError:  # pragma: no cover
    from config import Config  # type: ignore
    from model import ThreeDNeuronSpace  # type: ignore
    import train as train_mod  # type: ignore

PROJECT_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), os.pardir))
CHECKPOINT_DIR = os.path.join(PROJECT_ROOT, "checkpoints", "n3d_shape")
LEDGER = os.path.join(CHECKPOINT_DIR, "_verify", "full_runs_shape.json")
SHA_LEDGER = os.path.join(CHECKPOINT_DIR, "_verify", "full_runs_shape_sha256.json")

# 形状清单（两组共用）
SHAPES: List[Tuple[str, float]] = [
    ("sphere", 1.0),
    ("cube", 1.0),
    ("cylinder", 1.0),
    ("cylinder", 0.5),
    ("cylinder", 2.0),
]

# 两组对照（共享 seed=42 前提）：
#   * `any/any`：N=256, D=0.10（本模块原始 5 组，产物零改动，仅追加不重写）
#   * `all/all`：N=1024, D 逐形状对齐到该形状 any/any 的 params（±0.5%，见 README §16）
# 两组的 `D` 均从**账本现场取数**（不写死），避免"手填"与产物脱节。
GROUPS: List[Dict[str, Any]] = [
    dict(tag="anyany", input_scope="any_isolated", readout_scope="any_isolated",
         N=256, D_default=0.1, required=True),
    dict(tag="allall", input_scope="all_isolated", readout_scope="all_isolated",
         N=1024, D_default=None, required=True),
]
# 训练对照的固定超参（统一控制变量；D / N / scope 由组决定）
BASE_KW: Dict[str, Any] = dict(
    y_in=8, y_out=8, H=0.1, input_dim=784, output_dim=10,
    batch_size=64, lr=1e-3, epochs=10, seed=42, device="cpu",
)

# ======================================================================
# 冻结常量：5 条既有 any/any 产物的 SHA256（皋陶审查 #1，承重断言）
# ======================================================================
# [!] 为什么需要**代码内冻结常量**（而不是只靠账本）：
#     原先"既有 any/any 产物零改动"只依赖"账本保留旧值 + `sha256_unchanged_vs_previous_ledger`
#     标志"，**代码里没有任何断言**。若账本与产物被**一同重写**（例如重跑训练后账本也被刷新），
#     脚本**不会察觉** —— 即计划要求的"断言"实际退化成了"记录/打印"。
#     现改为：把 5 条产物的 SHA256 冻结为**本文件内的常量**，并断言**磁盘实测 SHA == 冻结常量**
#     （同时校验账本记录也等于该常量，防账本被改）。这样一来，既有产物一旦被改写即 FAIL。
#     ⚠️ 与 n3d_viz `[2d]` 的"只比磁盘、不重渲"不同：此处的关注对象**就是产物文件本身**，
#        故"读磁盘文件与冻结常量比对"即为**承重**校验，不存在绕过路径。
FROZEN_ANYANY: List[Tuple[str, str, str]] = [
    ("sphere|1.0|anyany",
     "full_shapesphere_N256_y8x8_H0.1_D0.1_plfcc_axz_isany_rsany_s42.pt",
     "c96a25d2e8bc86ece35ec61303687bd3ca94a30811d4512b0667870d86d11c1c"),
    ("cube|1.0|anyany",
     "full_shapecube_N256_y8x8_H0.1_D0.1_plfcc_axz_isany_rsany_s42.pt",
     "9d11e7dd07c10c9e6d7ffc35785a857b7b7aa08c4e1f51a76cf7f3f9991ad06d"),
    ("cylinder|1.0|anyany",
     "full_shapecylinder_a1_N256_y8x8_H0.1_D0.1_plfcc_axz_isany_rsany_s42.pt",
     "f18fff8b34c858ffed94ea56827690266b97adc42501989f8c0c18229d16f48c"),
    ("cylinder|0.5|anyany",
     "full_shapecylinder_a0.5_N256_y8x8_H0.1_D0.1_plfcc_axz_isany_rsany_s42.pt",
     "9ca88bacb3a0e50b1a30523fb134e6f9b2725fb08df60c146736b03c52a06534"),
    ("cylinder|2.0|anyany",
     "full_shapecylinder_a2_N256_y8x8_H0.1_D0.1_plfcc_axz_isany_rsany_s42.pt",
     "05c70a9df2611735328710d926320f618f2a2cb3cd679c489ce6eef38a8f9f81"),
]

# 冻结常量：两组 params 跨度的声明值（皋陶审查 #1 第 2 条，承重断言）
#   跨度定义 = max(params) / min(params)，在**该组 5 个形状**之间取；现场取数并断言。
#   README §16.2 声明的正是这两个值。
SPAN_TARGET_REL_TOL: float = 1e-4
FROZEN_SPAN: Dict[str, float] = {"anyany": 1.0571, "allall": 1.0553}


def sha256_of(path: str) -> str:
    """返回文件的 SHA256 十六进制摘要。"""
    return hashlib.sha256(open(path, "rb").read()).hexdigest()


def group_key(shape: str, lam: float, tag: str) -> str:
    """账本键：`{shape}|{lam}|{tag}`（**含 scope 组标记**，两组不互相覆盖）。"""
    return f"{shape}|{lam}|{tag}"


def main(argv: List[str] | None = None) -> int:
    """复算并比对账本；返回 0（一致）/ 1（不一致）。"""
    if not os.path.isfile(LEDGER):
        print(f"[FAIL] 账本不存在：{LEDGER}")
        return 1
    ledger = json.load(open(LEDGER, encoding="utf-8"))
    sha_ledger = (
        json.load(open(SHA_LEDGER, encoding="utf-8"))
        if os.path.isfile(SHA_LEDGER) else {}
    )

    problems: List[str] = []
    names: List[str] = []
    shas: List[str] = []
    per_group: Dict[str, List[Dict[str, Any]]] = {}
    print("=" * 118)
    print("n3d_shape 训练对照账本校验（独立复算 vs 账本；两组 x 5 形状 = 10 组）")
    print("=" * 118)
    for grp in GROUPS:
        tag = grp["tag"]
        per_group[tag] = []
        print(f"\n--- 组 {tag}（input_scope={grp['input_scope']}, "
              f"readout_scope={grp['readout_scope']}, N={grp['N']}）---")
        print(f"{'shape':10s} {'lam':>4s} {'D':>9s} {'acc(产物)':>9s} {'acc(账本)':>9s} "
              f"{'E':>6s} {'K':>3s} {'S_in':>5s} {'S_out':>6s} {'params':>8s} {'SHA':>10s}")
        for shape, lam in SHAPES:
            key = group_key(shape, lam, tag)
            led = ledger.get(key, {})
            # D 从**账本现场取数**（不写死）；账本缺该组时退回默认值并报问题
            if "D" in led:
                D = float(led["D"])
            elif grp["D_default"] is not None:
                D = float(grp["D_default"])
            else:
                problems.append(f"{key}: 账本缺 D，无法复算")
                print(f"{shape:10s} {lam:>4g}  MISSING-D")
                continue
            cfg = Config(**BASE_KW, N=grp["N"], D=D, shape=shape, cyl_aspect=lam,
                         input_scope=grp["input_scope"], readout_scope=grp["readout_scope"])
            name = train_mod.full_checkpoint_name(cfg)
            path = os.path.join(CHECKPOINT_DIR, name)
            if not os.path.isfile(path):
                problems.append(f"{key}: 产物缺失 {name}")
                print(f"{shape:10s} {lam:>4g} {D:>9.6f}  MISSING {name}")
                continue
            d = torch.load(path, map_location="cpu", weights_only=False)
            model = ThreeDNeuronSpace(cfg)
            acc = float(d["test_acc"])
            cs, ts = d["connection_stats"], d["topology_stats"]
            e = int(cs["num_edges"])
            k = int(ts["num_layers_true"])
            s_in = int(cs["num_in_scope"])
            s_out = int(cs["num_out_scope"])
            params = int(model.count_parameters())
            sha = sha256_of(path)
            names.append(name)
            shas.append(sha)
            rec = dict(key=key, shape=shape, lam=lam, D=D, acc=acc, E=e, K=k,
                       S_in=s_in, S_out=s_out, params=params, name=name, sha=sha)
            per_group[tag].append(rec)
            print(f"{shape:10s} {lam:>4g} {D:>9.6f} {acc * 100:>8.2f}% "
                  f"{float(led.get('test_acc', -1)) * 100:>8.2f}% "
                  f"{e:>6d} {k:>3d} {s_in:>5d} {s_out:>6d} {params:>8d} {sha[:10]:>10s}")
            # 账本一致性
            if not led:
                problems.append(f"{key}: 账本缺该组")
                continue
            if abs(float(led.get("test_acc", -1.0)) - acc) > 1e-12:
                problems.append(f"{key}: test_acc 账本 {led.get('test_acc')} != 产物 {acc}")
            for fld, val in (("E", e), ("K", k), ("S_in", s_in), ("S_out", s_out),
                             ("params", params)):
                if fld in led and led[fld] != val:
                    problems.append(f"{key}: {fld} 账本 {led[fld]} != 复算 {val}")
            # 产物自带形状取证
            if d["config"].get("shape") != shape:
                problems.append(f"{key}: 产物 config['shape']={d['config'].get('shape')!r} != {shape!r}")
            if shape == "cylinder" and float(d["config"].get("cyl_aspect", -1)) != lam:
                problems.append(f"{key}: 产物 cyl_aspect={d['config'].get('cyl_aspect')} != {lam}")
            if d.get("shape_tag") != cfg.shape_tag():
                problems.append(f"{key}: 产物 shape_tag={d.get('shape_tag')!r} != {cfg.shape_tag()!r}")
            if d["config"].get("seed") != BASE_KW["seed"]:
                problems.append(f"{key}: 产物 seed={d['config'].get('seed')} != {BASE_KW['seed']}")
            # 组特异取证：scope / N / D 必须与账本一致（防"两组串档"）
            for fld, expect in (("input_scope", grp["input_scope"]),
                                ("readout_scope", grp["readout_scope"]),
                                ("N", grp["N"])):
                if d["config"].get(fld) != expect:
                    problems.append(
                        f"{key}: 产物 config['{fld}']={d['config'].get(fld)!r} != {expect!r}")
            if abs(float(d["config"].get("D", -1.0)) - D) > 1e-12:
                problems.append(f"{key}: 产物 config['D']={d['config'].get('D')} != {D}")
            if sha_ledger and sha_ledger.get(name) and sha_ledger[name] != sha:
                problems.append(f"{key}: SHA256 与 SHA 账本不一致")

    # ---- 组内跨形状：E/K 在两种 scope 下必须相同（scope 不影响拓扑的回归锚点）----
    print("\n--- scope 不影响拓扑：同形状同 D 下 E/K 在 any/any 与 all/all 之间必须相同 ---")
    by_shape_any = {r["shape"] + "|" + str(r["lam"]): r for r in per_group.get("anyany", [])}
    # 注意：两组 D 不同（对齐 params 用的），故 E/K 比较须在**同一 D** 下另做（见下）
    # 此处只做"D 对齐前后"的展示；严格断言在 scope_invariance_check() 中按同一 D 复算。
    for tag in ("anyany", "allall"):
        recs = per_group.get(tag, [])
        if recs:
            pmin = min(r["params"] for r in recs)
            pmax = max(r["params"] for r in recs)
            print(f"  组 {tag}: params 跨度 [{pmin}, {pmax}] (max/min={pmax / pmin:.6f})，"
                  f"形状数={len(recs)}")

    # ==================================================================
    # 承重断言 A（皋陶审查 #1 第 1 条）：既有 5 组 any/any 产物 SHA256 冻结比对
    # ==================================================================
    print("-" * 100)
    print("既有 5 组 any/any 产物 SHA256 冻结比对（承重：产物一改即 FAIL）")
    for key, name, frozen in FROZEN_ANYANY:
        path = os.path.join(CHECKPOINT_DIR, name)
        if not os.path.isfile(path):
            problems.append(f"[FROZEN-SHA256] {key}: 产物缺失 {name}")
            print(f"  [FAIL] {key}: MISSING {name}")
            continue
        disk = sha256_of(path)
        if disk != frozen:
            problems.append(
                f"[FROZEN-SHA256] {key}: 磁盘实测 {disk} != 冻结常量 {frozen}（既有产物被改写）")
        led_sha = ledger.get(key, {}).get("sha256")
        if led_sha != frozen:
            problems.append(
                f"[FROZEN-SHA256] {key}: 账本记录 {led_sha} != 冻结常量 {frozen}")
        print(f"  [{' ok ' if disk == frozen and led_sha == frozen else 'FAIL'}] {key:22s} "
              f"disk={disk[:12]} ledger={str(led_sha)[:12]} frozen={frozen[:12]}")

    # ==================================================================
    # 承重断言 B（皋陶审查 #1 第 2 条）：两组 params 跨度 == 声明值
    # ==================================================================
    print("-" * 100)
    print("两组 params 跨度断言（现场取数 vs README §16.2 声明值）")
    span_records: Dict[str, Any] = {}
    span_problems: List[str] = []
    span_incomplete = False
    for tag, target in FROZEN_SPAN.items():
        recs = per_group.get(tag, [])
        if not recs:
            span_problems.append(f"[SPAN] {tag}: 无记录，无法计算跨度")
            span_incomplete = True
            continue
        ps = [r["params"] for r in recs]
        if len(recs) != len(SHAPES):
            # 记录不全时跨度可能被低估 -> 该组整体判为不完整（不落盘）
            span_problems.append(
                f"[SPAN] {tag}: 记录数 {len(recs)} != 形状数 {len(SHAPES)}，跨度不可信")
            span_incomplete = True
        pmin, pmax = min(ps), max(ps)
        got = pmax / pmin
        rel = abs(got - target) / target
        ok = rel <= SPAN_TARGET_REL_TOL
        if not ok:
            span_problems.append(
                f"[SPAN] {tag}: max/min={got:.6f} vs 声明 {target}（相对偏差 {rel:.2e} "
                f"> {SPAN_TARGET_REL_TOL}）；实测 min={pmin} max={pmax}")
        span_records[tag] = {
            "params_min": pmin, "params_max": pmax, "span_max_over_min": got,
            "declared_in_readme": target, "rel_dev_vs_declared": rel,
            "within_rel_tol": bool(ok), "rel_tol": SPAN_TARGET_REL_TOL,
        }
        print(f"  [{' ok ' if ok else 'FAIL'}] {tag:7s}: min={pmin} max={pmax} "
              f"max/min={got:.6f}（声明 {target}，相对偏差 {rel:.2e}）")
    problems.extend(span_problems)
    # [!] 落盘守卫（离朱 R14 观察 1）：**跨度断言或任一记录不完整时不得写账本**。
    #     否则"失败运行"（例如为做拒绝证明而临时篡改 `FROZEN_SPAN`）会把被篡改的
    #     期望值当作 `declared_in_readme` 落盘，**污染取证账本**（取证文件必须只记录
    #     真实可信的实测状态）。故仅在跨度断言自身全绿、且 10 条记录齐全时写入。
    if span_records and not span_problems and not span_incomplete:
        ledger["_span_assertion"] = span_records
        json.dump(ledger, open(LEDGER, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
        print(f"  [信息] 跨度实测已写入账本键 `_span_assertion`（{LEDGER}）")
    else:
        print("  [跳过] 跨度断言未全绿或记录不完整 -> **不写账本**"
              "（避免失败运行污染取证账本；离朱 R14 观察 1）")

    # 防撞名：名字与 SHA256 均须两两唯一（两组共 10 组，含 shape_tag + scope + D）
    if len(set(names)) != len(names):
        problems.append(f"产物名存在重复：{names}")
    if len(set(shas)) != len(shas):
        problems.append(f"产物 SHA256 存在重复：{[s[:12] for s in shas]}")

    print("-" * 100)
    print(f"{len(names)} 组产物名互不相同：{len(set(names)) == len(names)}")
    print(f"{len(shas)} 组 SHA256 互不相同：{len(set(shas)) == len(shas)}")

    # ---- scope 不影响拓扑：**同一 D** 下 E/K 在 any/any 与 all/all 之间必须相同 ----
    # （两组各自对齐 params 用的 D 不同，故须构造"同 D x 两种 scope"的配对做严格断言）
    print("-" * 100)
    print("scope 不影响拓扑：同 D 下 E/K 跨 scope 恒定（回归锚点）")
    for shape, lam in SHAPES:
        Ds = sorted({r["D"] for tag in ("anyany", "allall") for r in per_group.get(tag, [])
                     if r["shape"] == shape and r["lam"] == lam})
        for D in Ds:
            try:
                ca = Config(**BASE_KW, N=1024, D=D, shape=shape, cyl_aspect=lam,
                            input_scope="any_isolated", readout_scope="any_isolated")
                cb = Config(**BASE_KW, N=1024, D=D, shape=shape, cyl_aspect=lam,
                            input_scope="all_isolated", readout_scope="all_isolated")
                ma, mb = ThreeDNeuronSpace(ca), ThreeDNeuronSpace(cb)
                ka = int(ma.get_topology_stats()["num_layers_true"])
                kb = int(mb.get_topology_stats()["num_layers_true"])
                same = (ma.num_edges == mb.num_edges) and (ka == kb)
                if not same:
                    problems.append(
                        f"scope-invariance: {shape}|{lam}|D={D} "
                        f"E={ma.num_edges}/{mb.num_edges} K={ka}/{kb} 不相同")
                print(f"  {shape:9s} lam={lam:<4} D={D:.6f}: E={ma.num_edges}/{mb.num_edges} "
                      f"K={ka}/{kb} 相同={same}")
            except Exception as exc:
                problems.append(f"scope-invariance: {shape}|{lam}|D={D} 构造失败 {exc}")

    # ---- params 对齐偏差（all/all 相对该形状 any/any 的 params）----
    print("-" * 100)
    print("ALL/ALL params 对齐偏差（相对同形状 ANY/ANY，容差 ±0.5%）")
    any_target = {}
    # any/any 组用的是 N=256/D=0.1 的同名形状产物（不在本 10 组内），故对齐目标从账本取
    for shape, lam in SHAPES:
        tgt = ledger.get(group_key(shape, lam, "anyany"), {}).get("target_params")
        if tgt is None:
            # 回退：用账本中 any/any 记录的 params（若同键）
            tgt = ledger.get(group_key(shape, lam, "anyany"), {}).get("params")
        any_target[(shape, lam)] = tgt
    for r in per_group.get("allall", []):
        tgt = any_target.get((r["shape"], r["lam"]))
        if tgt is None:
            print(f"  {r['shape']:9s} lam={r['lam']:<4}: 账本缺 any/any 对齐目标，跳过")
            continue
        dev = (r["params"] - tgt) / tgt * 100.0
        ok = abs(dev) <= 0.5
        if not ok:
            problems.append(f"{r['key']}: params 对齐偏差 {dev:+.3f}% 超出 ±0.5%")
        print(f"  {r['shape']:9s} lam={r['lam']:<4} D={r['D']:.6f}: params={r['params']} "
              f"target={tgt} dev={dev:+.3f}% {'OK' if ok else 'OUT-OF-TOL'}")

    # ---- E1 回归：cylinder 的严格体积解与"曾被误拒的 λ" ----
    # 皋陶审查 E1：修复前 R_min 被抬高 (6/π)^(1/3)=1.240701 倍，使 DEFAULT 规模下
    # λ∈(2.20, 3.22) 被误判为"窗口为空"而拒绝。此处做两项**独立**核验：
    #   (a) 实现值与由体积不等式 `2πλr³ >= N·(4/3)πH³/φ` 独立反解的值逐位一致；
    #   (b) 曾被误拒的 λ=2.2/2.5/3.0/3.2 现在能构造且窗口非空；
    #   (c) 真正的空窗口（λ=4.0）仍须被正确拒绝（不得因修复而失去保护）。
    print("-" * 100)
    print("E1 回归（cylinder 严格体积解）")
    phi = 0.7405
    _e1_N, _e1_H = 256, 0.1
    _e1_kw = {**BASE_KW, "D": 0.1, "N": _e1_N, "H": _e1_H}
    for lam in (0.5, 1.0, 2.0, 2.5, 3.0):
        c = Config(**_e1_kw, shape="cylinder", cyl_aspect=lam)
        need = _e1_N * (4.0 / 3.0) * math.pi * _e1_H ** 3 / phi
        derived = (need / (2.0 * math.pi * lam)) ** (1.0 / 3.0)
        same = abs(c.min_space_radius - derived) <= 1e-12
        if not same:
            problems.append(
                f"E1: lambda={lam} R_min={c.min_space_radius:.9f} != 体积反解 {derived:.9f}"
            )
        print(f"  lambda={lam:<4}: R_min={c.min_space_radius:.9f} 体积反解={derived:.9f} 一致={same}")
    for lam in (2.2, 2.5, 3.0, 3.2):
        try:
            c = Config(**_e1_kw, shape="cylinder", cyl_aspect=lam)
            nonempty = c.max_space_radius >= c.min_space_radius
            print(f"  曾被误拒 lambda={lam}: 构造成功 R_min={c.min_space_radius:.6f} "
                  f"R_max={c.max_space_radius:.6f} 窗口非空={nonempty}")
            if not nonempty:
                problems.append(f"E1: lambda={lam} 窗口为空")
        except ValueError as exc:
            problems.append(f"E1: lambda={lam} 仍被误拒 -> {exc}")
    try:
        Config(**_e1_kw, shape="cylinder", cyl_aspect=4.0)
        problems.append("E1: lambda=4.0 应因窗口为空被拒，但构造成功")
    except ValueError:
        print("  真实空窗口 lambda=4.0 仍被正确拒绝")
    if problems:
        print(f"\n[FAIL] 发现 {len(problems)} 项不一致：")
        for p in problems:
            print(f"  - {p}")
        return 1
    print("\n[PASS] 账本与产物逐项一致，且产物名/SHA256 两两唯一")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
